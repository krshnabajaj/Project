{
  "name": "machine-order-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Order Management & Machine Assembly Tracking system",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx scripts/worker.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "create-admin": "tsx scripts/create-admin.ts",
    "mail:dev": "tsx scripts/dev-mail-catcher.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@aws-sdk/s3-request-presigner": "^3.1143.0",
    "@googleapis/gmail": "^22.0.1",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "google-auth-library": "^11.1.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.49.0",
    "mammoth": "^1.13.0",
    "next": "^16.3.7",
    "next-auth": "^4.24.15",
    "nodemailer": "^7.0.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.63.0",
    "prisma": "^6.19.3",
    "smtp-server": "^3.19.16",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.0.2"
  }
