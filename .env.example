# =====================================================================
#  Machine Order Tracker — environment configuration
#  Copy to `.env` and fill in real values. NEVER commit real credentials.
# =====================================================================

# --- Core -------------------------------------------------------------
# Public base URL of the app (used in email links and OAuth redirects)
APP_URL=http://localhost:3000
# Business timezone used for "today", daily updates and overdue checks
APP_TIMEZONE=Asia/Kolkata
NEXT_PUBLIC_APP_TIMEZONE=Asia/Kolkata
NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 32
NEXTAUTH_SECRET=
# 32-byte key (base64) used to encrypt Gmail OAuth tokens at rest: openssl rand -base64 32
ENCRYPTION_KEY=
# Bearer token that protects /api/cron/* endpoints: openssl rand -hex 24
CRON_SECRET=

# --- Database ---------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/oms?schema=public

# --- Gmail API (OAuth 2.0) -------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback
# Mailbox that receives POs (the account you connect in Settings > Gmail)
GMAIL_USER=
# Optional: Gmail push via Cloud Pub/Sub (polling is always the fallback)
GMAIL_PUBSUB_TOPIC=
# Audience configured on the Pub/Sub push subscription (OIDC token check)
GMAIL_PUBSUB_AUDIENCE=
# Service-account email the Pub/Sub subscription signs push requests with
GMAIL_PUBSUB_SERVICE_ACCOUNT=
GMAIL_POLL_INTERVAL_MINUTES=5

# --- WhatsApp -----------------------------------------------------------
# meta | twilio | disabled
WHATSAPP_PROVIDER=disabled
# Meta: https://graph.facebook.com/v21.0   Twilio: https://api.twilio.com/2010-04-01
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
# Meta: permanent system-user token.  Twilio: Auth Token
WHATSAPP_ACCESS_TOKEN=
# Meta: WhatsApp phone number ID.  Twilio: Account SID
WHATSAPP_PHONE_NUMBER_ID=
# Twilio only: WhatsApp-enabled sender number in E.164, e.g. +14155238886
WHATSAPP_FROM_NUMBER=
# Meta only (optional): approved template used for business-initiated messages.
# Template must have ONE body parameter ({{1}}) that receives the message text.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
# Admin mobile in E.164 (can also be changed in Settings > WhatsApp)
ADMIN_WHATSAPP_NUMBER=

# --- Outgoing email (completion summaries) -----------------------------
# smtp | gmail (sends via the connected Gmail account) | disabled
EMAIL_PROVIDER=smtp
EMAIL_FROM="Machine Order Tracker <no-reply@example.com>"
ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- File storage -----------------------------------------------------
# s3 (AWS S3, Cloudflare R2, Supabase Storage S3 endpoint, MinIO) | local (development only)
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto
# Required for R2 / Supabase / MinIO, e.g. https://<account>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=false
# Local provider directory (development only)
STORAGE_LOCAL_DIR=./storage
# Only for a single-server deployment with a persistent, backed-up volume:
# ALLOW_LOCAL_STORAGE_IN_PRODUCTION=true
# Max size of a single uploaded photo / document in MB
MAX_UPLOAD_MB=10
